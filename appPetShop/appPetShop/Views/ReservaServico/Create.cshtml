@model appPetShop.Models.ReservaServico

@{
    ViewData["Title"] = "Nova reserva de serviço";
}

<h1>Nova reserva de serviço</h1>

<h4>ReservaServico</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger">
            </div>

            <div class="form-group mb-3">
                <label asp-for="DataHora" class="control-label"></label>

                <input asp-for="DataHora"
                       class="form-control"
                       type="datetime-local" />

                <span asp-validation-for="DataHora"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Valor" class="control-label"></label>

                <input asp-for="Valor"
                       class="form-control"
                       type="number"
                       step="0.01" />

                <span asp-validation-for="Valor"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StatusServico" class="control-label"></label>

                <input asp-for="StatusServico"
                       class="form-control" />

                <span asp-validation-for="StatusServico"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClienteId" class="control-label">
                    Cliente
                </label>

                <select asp-for="ClienteId"
                        class="form-control"
                        asp-items="ViewBag.ClienteId">
                    <option value="">Selecione o cliente</option>
                </select>

                <span asp-validation-for="ClienteId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="VeterinarioId" class="control-label">
                    Veterinário
                </label>

                <select asp-for="VeterinarioId"
                        class="form-control"
                        asp-items="ViewBag.VeterinarioId">
                    <option value="">Selecione o veterinário</option>
                </select>

                <span asp-validation-for="VeterinarioId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Criar"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
